[Unit]
Description=LUMI - OVOS MessageBus
After=network.target
[Service]
User=@USER@
WorkingDirectory=@HOME@/lumi
Environment="HOME=@HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecStart=@HOME@/.venvs/ovos/bin/ovos-messagebus
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
